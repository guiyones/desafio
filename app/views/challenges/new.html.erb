<% content_for :title, "Novo desafio" %>

<h1 class="pixel">Novo desafio em <%= @group.name %></h1>

<div class="box">
  <%= form_with model: [ @group, @challenge ] do |form| %>
    <%= render "shared/errors", record: @challenge %>

    <p>
      <%= form.label :name, "Nome" %>
      <%= form.text_field :name, autofocus: true %>
    </p>

    <p>
      <%= form.label :skill_id, "Skill" %>
      <%= form.collection_select :skill_id, Skill.order(:name), :id, ->(s) { "#{s.icon} #{s.name}" }, include_blank: "— nenhuma —" %>
    </p>

    <%= form.submit "Criar desafio" %>
  <% end %>
</div>

<p><%= link_to "Voltar", @group.project, class: "button" %></p>
