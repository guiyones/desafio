<%= turbo_stream.replace day_dom_id(@challenge, @slip.day),
      partial: "challenges/day", locals: { challenge: @challenge, date: @slip.day, breaking: true } %>
<%= turbo_stream.replace dom_id(@challenge, :xp),
      partial: "challenges/xp", locals: { challenge: @challenge } %>
<%= turbo_stream.replace "tally",
      partial: "projects/tally", locals: { project: @challenge.project } %>
