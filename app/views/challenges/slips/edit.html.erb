<% content_for :title, "Vacilo" %>

<h1 class="pixel"><%= @challenge.name %> · dia <%= @challenge.project.day_number(@slip.day) %></h1>
<p class="muted"><%= @slip.day.strftime("%d/%m/%Y") %></p>

<div class="box">
  <%= form_with model: @slip, url: challenge_slip_path(@challenge, @slip.day.iso8601) do |form| %>
    <p>
      <%= form.label :note, "Nota" %>
      <%= form.text_field :note, placeholder: "o que rolou?", autofocus: true %>
    </p>

    <%= form.submit "Salvar" %>
  <% end %>
</div>

<p><%= button_to "Remover vacilo", challenge_slip_path(@challenge, @slip.day.iso8601), method: :delete, class: "button button--danger" %></p>

<p><%= link_to "Voltar", @challenge.project, class: "button" %></p>
