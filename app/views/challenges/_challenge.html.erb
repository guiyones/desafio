<%# locals: (challenge:) %>
<article class="challenge">
  <h3><%= challenge.name %> <%= link_to "editar", edit_challenge_path(challenge), class: "muted" %></h3>

  <div class="days">
    <% challenge.project.days.each do |date| %>
      <%= render "challenges/day", challenge: challenge, date: date %>
    <% end %>
  </div>
</article>
