<%# locals: (challenge:, date:) %>
<% status = challenge.status_on(date) %>
<% label = "Dia #{challenge.project.day_number(date)}" %>
<div id="<%= day_dom_id(challenge, date) %>"
     class="day day--<%= status %><%= " day--today" if date == Date.current %>"
     title="<%= date.strftime("%d/%m") %>">
  <% if status == :kept %>
    <%= button_to "", challenge_slips_path(challenge), params: { day: date.iso8601 }, aria: { label: "#{label}: marcar vacilo" } %>
  <% elsif status == :slipped %>
    <%= link_to "", edit_challenge_slip_path(challenge, date.iso8601), aria: { label: "#{label}: vacilo, editar" } %>
  <% else %>
    <span role="img" aria-label="<%= label %>: futuro"></span>
  <% end %>
</div>
