<h1 class="pixel">Projetos</h1>

<ul class="stack">
  <% @projects.each do |project| %>
    <li class="box"><%= link_to project.name, project %> <span class="muted"><%= project_progress(project) %></span></li>
  <% end %>
</ul>

<p><%= link_to "Novo projeto", new_project_path, class: "button" %></p>
