<% content_for :title, "Resultado · #{@project.name}" %>

<p><%= link_to "← #{@project.name}", @project %></p>

<h1 class="pixel">Resultado</h1>

<header class="hud box result-stats">
  <p class="result-stats__row"><span class="muted">Dias decorridos</span><span class="pixel gold" id="elapsed_days_count"><%= @project.elapsed_days.count %> de <%= Project::DURATION %></span></p>
  <p class="result-stats__row"><span class="muted">Dias perfeitos</span><span class="pixel gold" id="perfect_days_count"><%= @project.perfect_days.size %></span></p>
  <p class="result-stats__row"><span class="muted">Vacilos</span><span class="pixel red" id="slips_count"><%= @project.slips_count %></span></p>
</header>

<% @groups.each do |group| %>
  <h2 class="section-title">▶ <%= group.name %> <span class="muted"><%= pluralize group.slips_count, "vacilo" %></span></h2>

  <div class="box results-table-wrap">
    <table class="results-table">
      <thead>
        <tr>
          <th>Desafio</th>
          <th>Vacilos</th>
          <th>Cumpridos</th>
          <th>%</th>
          <th>XP</th>
        </tr>
      </thead>
      <tbody>
        <% group.challenges.each do |challenge| %>
          <tr>
            <td><%= challenge.name %></td>
            <td><%= challenge.slips_count %></td>
            <td><%= challenge.kept_count %></td>
            <td><%= challenge.kept_percentage %>%</td>
            <td><%= challenge.xp %> XP</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<h2 class="section-title">▶ Vacilos</h2>

<% timeline = @project.slips_timeline.load %>
<% if timeline.any? %>
  <ol class="timeline box">
    <% timeline.each do |slip| %>
      <li>Dia <%= @project.day_number(slip.day) %> · <%= slip.challenge.name %><% if slip.note.present? %> · <%= slip.note %><% end %></li>
    <% end %>
  </ol>
<% else %>
  <p class="muted">Nenhum vacilo até agora.</p>
<% end %>
