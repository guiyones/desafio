<% content_for :title, @project.name %>

<%= level_up_banner(@groups.flat_map(&:challenges).filter_map(&:skill).uniq) %>

<header class="hud box">
  <div class="hud__row">
    <div class="hud__avatar" role="img" aria-label="Avatar">🧙</div>
    <div class="hud__info">
      <p class="pixel"><%= @project.name %></p>
      <p class="pixel gold">
        <% if @project.status == :active %>fase <%= @project.phase_on(Date.current) %> · <% end %><%= project_progress(@project) %>
      </p>
      <div class="hud__bar"><i style="width: <%= project_elapsed_percentage(@project) %>%"></i></div>
    </div>
  </div>
  <%= render "projects/tally", project: @project %>
</header>

<nav class="actions">
  <%= link_to "Resultado", project_results_path(@project), class: "button" %>
  <%= link_to "Novo grupo", new_project_group_path(@project), class: "button" %>
  <%= link_to "Editar projeto", edit_project_path(@project), class: "button" %>
  <%= link_to "Novo projeto", new_project_path, class: "button" %>
</nav>

<% @groups.each do |group| %>
  <details class="group" id="<%= dom_id(group) %>" open
           data-controller="group-toggle" data-action="toggle->group-toggle#save">
    <summary class="group__summary">
      <h2 class="group__title"><%= group.name %></h2>
      <%= link_to "editar", edit_group_path(group), class: "muted" %>
    </summary>

    <%= render group.challenges %>

    <p><%= link_to "Novo desafio", new_group_challenge_path(group), class: "button" %></p>
  </details>
<% end %>
